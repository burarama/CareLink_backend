generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MasterPatientStatus {
  ACTIVE
  DECEASED
  MERGED // merged into another record
  DUPLICATE // identified as duplicate, pending merge
  INACTIVE
}

enum MatchStatus {
  PENDING // not yet processed
  AUTO_MATCHED // system matched with high confidence
  MANUAL_MATCHED // human confirmed the match
  NO_MATCH // confirmed new patient
  REVIEW // in human review queue
  REJECTED // human rejected the match
}

enum MatchMethod {
  NATIONAL_ID // exact national ID match
  IPRS // confirmed via IPRS gateway
  PROBABILISTIC // fuzzy matching algorithm
  MANUAL // human decision
}

enum FacilityType {
  PUBLIC_HOSPITAL
  PRIVATE_HOSPITAL
  CLINIC
  HEALTH_CENTRE
  DISPENSARY
  LABORATORY
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  VIRTUAL
  HOME_VISIT
  DAY_CASE
}

enum EncounterStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  CANCELLED
  UNKNOWN
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  COMORBIDITY
  DISCHARGE
  REFERRAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  RULED_OUT
  REMISSION
}

enum LabCategory {
  HEMATOLOGY
  BIOCHEMISTRY
  MICROBIOLOGY
  IMMUNOLOGY
  PATHOLOGY
  IMAGING
  OTHER
}

enum LabResultStatus {
  FINAL
  PRELIMINARY
  CORRECTED
  CANCELLED
  ENTERED_IN_ERROR
}

enum MedicationStatus {
  ACTIVE
  COMPLETED
  STOPPED
  ON_HOLD
  UNKNOWN
}

enum SyncStatus {
  STARTED
  COMPLETED
  FAILED
  PARTIAL
}

model Facility {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  code       String            @unique
  type       FacilityType
  patients   FacilityPatient[]
  county     String
  isActive   Boolean           @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime          @default(now())
  encounters Encounter[]

  @@map("facilities")
}

//facility patient
model FacilityPatient {
  id              String         @id @default(uuid()) @db.Uuid
  facilityId      String         @db.Uuid
  masterPatientId String?        @db.Uuid
  externalId      String // patient ID in that hospital
  firstName       String
  lastName        String
  dob             String?
  gender          String
  facility        Facility       @relation(fields: [facilityId], references: [id])
  masterPatient   MasterPatient? @relation(fields: [masterPatientId], references: [id])
  encounters      Encounter[] // ← add this
}

//encounter
model Encounter {
  id                String   @id @default(uuid()) @db.Uuid
  masterPatientId   String?
  facilityPatientId String   @db.Uuid
  facilityId        String   @db.Uuid
  encounterDate     DateTime @default(now())

  facility        Facility        @relation(fields: [facilityId], references: [id])
  facilityPatient FacilityPatient @relation(fields: [facilityPatientId], references: [id])
}

//master patient
model MasterPatient {
  id        String    @id @default(uuid()) @db.Uuid
  firstName String
  idNumber String
  lastName  String
  dob       DateTime?
  gender    String?

  sourcePatients FacilityPatient[]
}
